{:id          :isaac.comm.gchat
 :version     "0.2.4"
 :builtin?    true
 :factory     isaac.comm.gchat.module/create-module
 :description "Google Chat comm for Isaac — inbound gate, routing and dispatch for spaces and DMs; outbound replies and sends. Built on isaac-google."

 :isaac.agent/comm
 {:gchat {:namespace    isaac.comm.gchat
          :extra-schema {:gchat/google      {:type        :keyword
                                             :description "Google organization (tenant) this comm speaks for: it sends with that organization's token and its spaces subscribe to that organization's topic. Omit on a host with one organization."}
                         :gchat/account     {:type        :string
                                             :description "Google account email of the Isaac user (echo drop)."}
                         :gchat/account-id  {:type        :string
                                             :description "Google Chat users/<id> of the Isaac user. Chat pushes Isaac's own replies back carrying users/<id> and no email, so matching :gchat/account alone cannot see them (isaac-mm7o). Learned automatically from the first outbound send; set it here to skip that wait."}
                         :gchat/allow-from  {:type        :seq
                                             :spec        {:type :string}
                                             :description "Inbound allowlist of senders: an email, *@domain for every address in a domain, a users/<id> resource name, or domain:<domainId> (the Workspace customer id Chat reports as sender.domainId). Chat's message API does not return emails for human senders under user auth, so users/… or domain:… is usually what you want. Missing or empty = fail-closed; a drop logs the sender's identity so it can be copied in."}
                         :gchat/message-cap {:type        :int
                                             :description "Chunk reply text above this character count. Chat's limit is 4096; default 4096."}
                         :gchat/spaces      {:type        :map
                                             :key-spec    {:type :keyword}
                                             :value-spec  {:type   :map
                                                           :schema {:name         {:type :string
                                                                                   :description "Friendly display name."}
                                                                    :session      {:type :string
                                                                                   :description "Explicit session id for this space"}
                                                                    :session-tags {:type :seq
                                                                                   :spec {:type :keyword}
                                                                                   :description "Tags the target session must carry (AND)"}
                                                                    :crew         {:type :string
                                                                                   :description "Crew for session selection or creation."}
                                                                    :reach        {:type :keyword
                                                                                   :validations [[:one-of? :one :all]]
                                                                                   :description "How many sessions to target"}
                                                                    :prefer       {:type :keyword
                                                                                   :validations [[:one-of? :recent :oldest]]
                                                                                   :description "Multi-match tiebreak when :reach is :one"}
                                                                    :create       {:type :keyword
                                                                                   :validations [[:one-of? :never :if-missing :always]]
                                                                                   :description "Create policy"}
                                                                    :respond      {:type        :keyword
                                                                                   :validations [[:one-of? :mentions :all :never]]
                                                                                   :description "When to start a turn: mentions (default), all, or never."}}}
                                             :description "Chat spaces configured by hand: overrides only. One subscription on spaces/- hears every space the account belongs to, so an entry subscribes nothing and an unlisted space is still heard - membership is the grant. An entry says what a space's session is called, which crew it runs on, and when it answers."}}
          :send-schema  {:gchat/space  {:type        :string
                                        :description "Chat space: configured :name or resource name (spaces/…)."}
                         :gchat/to     {:type        :string
                                        :description "User email. Resolves via spaces.findDirectMessage; spaces.setup DIRECT_MESSAGE when absent."}
                         :gchat/thread {:type        :string
                                        :description "Optional thread resource (spaces/…/threads/…) to reply in."}}}}

 ;; Chat tools on Isaac's own token and the crew's allow-list — a crew that
 ;; needs to read further back, or to speak somewhere it was not addressed,
 ;; asks Chat directly instead of shelling out (isaac-jqk2).
 :isaac.agent/tools
 {:gchat__spaces  {:factory isaac.comm.gchat.tools/spaces-tool-factory}
  :gchat__history {:factory isaac.comm.gchat.tools/history-tool-factory}
  :gchat__send    {:factory isaac.comm.gchat.tools/send-tool-factory}}

 :isaac.google/handler
 {"google.workspace.chat.message.v1.created"    isaac.comm.gchat.handler/handle-event
  "google.workspace.chat.message.v1.updated"    isaac.comm.gchat.handler/handle-event
  "google.workspace.chat.message.v1.deleted"    isaac.comm.gchat.handler/acknowledge-event
  "google.workspace.chat.membership.v1.created" isaac.comm.gchat.handler/acknowledge-event
  "google.workspace.chat.membership.v1.updated" isaac.comm.gchat.handler/acknowledge-event
  "google.workspace.chat.membership.v1.deleted" isaac.comm.gchat.handler/acknowledge-event}

 :isaac.google/registration
 {:chat {:create! isaac.comm.gchat.registration/create!
         :renew!  isaac.comm.gchat.registration/renew!
         :expiry  isaac.comm.gchat.registration/expiry
         :key     isaac.comm.gchat.registration/subscription-keys}}

 ;; chat.memberships.readonly: the spaces/- subscription carries membership
 ;; event types, and Workspace Events refuses the create without it
 ;; ("Request had insufficient authentication scopes", yopp 2026-09-23).
 :isaac.google/scopes
 ["https://www.googleapis.com/auth/chat.messages"
  "https://www.googleapis.com/auth/chat.spaces.readonly"
  "https://www.googleapis.com/auth/chat.memberships.readonly"
  ;; chat.spaces.create: spaces:setup — Yopp opens a DM to a person, and joins
  ;; a DM it was only invited to (message request pending, yopp 2026-09-23).
  "https://www.googleapis.com/auth/chat.spaces.create"]
 }
